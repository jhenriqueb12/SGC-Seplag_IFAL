PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sgc_seplag
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Notificações de vencimento (5, 4 e 3 meses antes)
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_CRON=0 8 * * *
NOTIFICATIONS_TIMEZONE=America/Maceio
SMTP_HOST=smtp.seu-dominio.gov.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SGC - Gestão de Contratos <nao-responda@seu-dominio.gov.br>
# Para testar localmente com Mailpit (docker compose --profile dev up -d)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
